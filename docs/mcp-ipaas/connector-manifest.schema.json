{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/industrial-mcp-connector-manifest.schema.json",
  "title": "Industrial MCP Connector Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "version",
    "vendor",
    "domain",
    "owner",
    "provenance",
    "execution",
    "protocol",
    "auth",
    "capabilities",
    "tools",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 80
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "vendor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "domain": {
      "enum": ["cad", "cam", "cae", "plm", "erp", "mes", "qms", "ot", "other"]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "contact"],
      "properties": {
        "team": { "type": "string", "minLength": 1 },
        "contact": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "sourceUrl", "revision", "license", "artifactDigest", "reviewedAt"],
      "properties": {
        "sourceType": { "enum": ["vendor", "community", "internal"] },
        "sourceUrl": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "minLength": 7 },
        "license": { "type": "string", "minLength": 1 },
        "licenseApproved": { "type": "boolean", "default": false },
        "artifactDigest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
        "sbomRef": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement", "transport", "concurrency", "timeoutMs"],
      "properties": {
        "placement": { "enum": ["cloud", "vpc", "edge-windows", "edge-linux", "hpc"] },
        "transport": { "enum": ["stdio", "streamable-http", "sse-legacy"] },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "endpointRef": { "type": "string" },
        "workingDirectoryRef": { "type": "string" },
        "environmentSecretRefs": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^secret://" }
        },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "workspaceRequired": { "type": "boolean", "default": true },
        "outboundOnly": { "type": "boolean", "default": true }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "stdio" } } },
          "then": { "required": ["command"] },
          "else": { "required": ["endpointRef"] }
        }
      ]
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumVersion", "testedVersion", "schemaSnapshotHash"],
      "properties": {
        "minimumVersion": { "type": "string", "format": "date" },
        "testedVersion": { "type": "string", "format": "date" },
        "schemaSnapshotHash": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
        "backwardCompatibilityTested": { "type": "boolean", "default": false }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "secretRefs"],
      "properties": {
        "type": {
          "enum": [
            "none",
            "local-session",
            "oauth2-authorization-code-pkce",
            "oauth2-client-credentials",
            "api-key",
            "windows-integrated",
            "mtls"
          ]
        },
        "secretRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^secret://" }
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "stepUpSupported": { "type": "boolean", "default": false }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "resources", "prompts", "tasks"],
      "properties": {
        "tools": { "type": "boolean" },
        "resources": { "type": "boolean" },
        "prompts": { "type": "boolean" },
        "tasks": { "type": "boolean" }
      }
    },
    "supportedApplicationVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expression", "status"],
        "properties": {
          "expression": { "type": "string" },
          "status": { "enum": ["certified", "targeted", "experimental", "blocked"] }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthTool", "killSwitch", "rollbackSupported", "supportRunbookRef"],
      "properties": {
        "healthTool": { "type": "string" },
        "killSwitch": { "type": "boolean", "const": true },
        "rollbackSupported": { "type": "boolean" },
        "supportRunbookRef": { "type": "string", "minLength": 1 },
        "metricsPrefix": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "inputSchemaHash",
        "risk",
        "approval",
        "idempotency",
        "timeoutMs",
        "maxAttempts",
        "dataClassifications",
        "enabledByDefault",
        "verificationRequired"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
        "inputSchemaHash": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
        "risk": { "enum": ["read", "create-isolated", "mutate", "destructive", "physical-control"] },
        "approval": { "enum": ["none", "policy", "always"] },
        "idempotency": { "enum": ["required", "supported", "none"] },
        "scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "dataClassifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["public", "internal", "confidential", "restricted", "export-controlled"] }
        },
        "enabledByDefault": { "type": "boolean", "const": false },
        "workspaceRequired": { "type": "boolean", "default": true },
        "checkpointRequired": { "type": "boolean", "default": false },
        "verificationRequired": { "type": "boolean" },
        "resultSchemaRef": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "risk": { "enum": ["destructive", "physical-control"] } } },
          "then": { "properties": { "approval": { "const": "always" } } }
        },
        {
          "if": { "properties": { "risk": { "enum": ["mutate", "destructive"] } } },
          "then": {
            "properties": {
              "checkpointRequired": { "const": true },
              "verificationRequired": { "const": true }
            }
          }
        },
        {
          "if": { "properties": { "risk": { "const": "mutate" } } },
          "then": { "properties": { "approval": { "enum": ["policy", "always"] } } }
        },
        {
          "if": { "properties": { "risk": { "const": "destructive" } } },
          "then": { "properties": { "maxAttempts": { "const": 1 } } }
        },
        {
          "if": { "properties": { "risk": { "const": "physical-control" } } },
          "then": { "properties": { "enabledByDefault": { "const": false }, "maxAttempts": { "const": 1 } } }
        }
      ]
    }
  }
}
